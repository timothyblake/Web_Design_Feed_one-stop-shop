---
const year = new Date().getFullYear();

const socialLinks = [
  {
    href: "https://twitter.com/webdesignfeed",
    label: "Web Design Feed on Twitter",
    testId: "x-logo-svg",
    path: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z",
  },
  {
    href: "https://www.facebook.com/webdesignfeed",
    label: "Web Design Feed on Facebook",
    testId: "facebook-logo-svg",
    path: "M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z",
  },
];
---

<footer
  class="bg-white mt-auto w-full py-8 px-gutter shadow-divider-top"
>
  <div
    class="max-w-container-max mx-auto w-full flex flex-col items-center gap-4 md:flex-row md:justify-between"
  >
    <nav
      aria-label="Footer"
      class="flex flex-wrap items-center gap-x-6 gap-y-2 justify-center md:justify-start"
    >
      <span class="flex items-center" role="group" aria-label="Social media">
        {
          socialLinks.map(({ href, label, testId, path }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${label} (opens in a new tab)`}
              title={label}
              class="group flex h-8 w-8 items-center justify-center"
            >
              <span
                class="flex h-5 w-5 items-center justify-center rounded-full border border-black bg-black text-white transition-opacity group-hover:opacity-75"
                aria-hidden="true"
              >
                <svg
                  width="12.5"
                  height="12.5"
                  viewBox="0 0 24 24"
                  data-testid={testId}
                  fill="currentColor"
                >
                  <path d={path} />
                </svg>
              </span>
            </a>
          ))
        }
      </span>

      <a
        href="/feeds"
        class="text-sm text-on-surface-variant hover:text-secondary transition-colors"
        >RSS Feeds</a
      >
      <a
        href="/newsletter"
        class="text-sm text-on-surface-variant hover:text-secondary transition-colors"
        >Newsletter</a
      >
      <a
        href="/about"
        class="text-sm text-on-surface-variant hover:text-secondary transition-colors"
        >About</a
      >
    </nav>

    <p
      class="font-body-md text-sm text-primary text-center md:text-right"
    >
      {`© ${year} All rights reserved. Web Design Feed`}
    </p>
  </div>
</footer>
