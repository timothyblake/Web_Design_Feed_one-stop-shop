---
// Switches every `[data-story-list]` on the page between the default grid
// and a single-column list. Preference persists in localStorage so it
// carries across ClientRouter page navigations.
// Plain CSS below (not Tailwind utilities) because the layout class is
// applied at runtime via classList.toggle — Tailwind's build-time scanner
// only sees literal classes in markup, so responsive utility strings
// assembled in JS get purged from the production build.
import Icon from './Icon.astro';
---

<div class="view-toggle hidden sm:flex items-center gap-1 shrink-0" role="group" aria-label="Story layout">
  <button
    type="button"
    class="view-toggle-btn p-1.5 rounded-lg text-primary hover:bg-surface-variant transition-colors"
    data-view-btn="grid"
    aria-pressed="true"
    aria-label="Grid view"
  >
    <Icon name="grid_view" size={20} />
  </button>
  <button
    type="button"
    class="view-toggle-btn p-1.5 rounded-lg text-primary hover:bg-surface-variant transition-colors"
    data-view-btn="list"
    aria-pressed="false"
    aria-label="List view"
  >
    <Icon name="view_list" size={20} />
  </button>
</div>

<style is:global>
  [data-story-list].is-grid-view {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    align-items: stretch;
  }

  @media (min-width: 640px) {
    [data-story-list].is-grid-view {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    [data-story-list]:not(.is-grid-view) .story-card {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }

    [data-story-list]:not(.is-grid-view) .story-thumbnail {
      flex: 0 0 300px;
      width: 300px;
      height: 180px;
      margin: 0;
      border-radius: 0.75rem;
      align-self: center;
    }

    [data-story-list]:not(.is-grid-view) .story-thumbnail img {
      width: 100%;
      height: 100%;
    }
  }

  /* Grid items stretch to the row height by default, but that height has to
     be passed down through the <li> to the card itself for equal-height rows. */
  [data-story-list].is-grid-view > li {
    display: flex;
  }

  [data-story-list].is-grid-view > li > article {
    flex: 1;
    width: 100%;
  }

  [data-story-list].is-grid-view .story-thumbnail img {
    aspect-ratio: 43 / 20;
  }

  [data-story-list].is-grid-view .story-category-pill {
    background-color: var(--color-accent-ink);
  }

  [data-story-list].is-grid-view > li:nth-child(4n + 1) .story-category-pill,
  [data-story-list].is-grid-view > li:nth-child(4n + 4) .story-category-pill {
    background-color: var(--color-secondary);
  }
</style>

<script>
  const STORAGE_KEY = 'story-view-mode';

  type ViewMode = 'list' | 'grid';

  function applyView(mode: ViewMode) {
    document.querySelectorAll<HTMLElement>('[data-story-list]').forEach((list) => {
      list.classList.toggle('is-grid-view', mode === 'grid');
    });
    document.querySelectorAll<HTMLImageElement>('.story-thumbnail img').forEach((image) => {
      const nextSrc = mode === 'grid' ? image.dataset.gridSrc : image.dataset.listSrc;
      if (nextSrc && image.getAttribute('src') !== nextSrc) {
        image.setAttribute('src', nextSrc);
      }
      image.setAttribute('width', mode === 'grid' ? '430' : '300');
      image.setAttribute('height', mode === 'grid' ? '200' : '180');
    });
    document.querySelectorAll<HTMLButtonElement>('[data-view-btn]').forEach((btn) => {
      const active = btn.dataset.viewBtn === mode;
      btn.setAttribute('aria-pressed', String(active));
      btn.classList.toggle('bg-surface-variant', active);
      btn.classList.toggle('text-secondary', active);
    });
  }

  function initViewToggle() {
    const stored = localStorage.getItem(STORAGE_KEY);
    applyView(stored === 'list' ? 'list' : 'grid');

    document.querySelectorAll<HTMLButtonElement>('[data-view-btn]').forEach((btn) => {
      if (btn.dataset.viewInit) return;
      btn.dataset.viewInit = 'true';

      btn.addEventListener('click', () => {
        const mode = btn.dataset.viewBtn as ViewMode;
        localStorage.setItem(STORAGE_KEY, mode);
        applyView(mode);
      });
    });
  }

  initViewToggle();
  document.addEventListener('astro:page-load', initViewToggle);
</script>
