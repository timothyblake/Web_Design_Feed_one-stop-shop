---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import NewsletterCTA from '../components/ui/NewsletterCTA.astro';
import PageHeading from '../components/ui/PageHeading.astro';
import Icon from '../components/ui/Icon.astro';
---

<BaseLayout
  title="Newsletter"
  description="Subscribe to the monthly Web Design Feed update for standout design and development stories, useful resources, and fresh inspiration."
>
  <Breadcrumb items={[{ label: 'Newsletter', href: '/newsletter' }]} />

  <PageHeading>The Monthly Update</PageHeading>
  <p class="text-on-surface-variant mb-stack-lg leading-relaxed">
    Once a month, we bring together standout <a href="/featured" class="underline hover:text-primary">editor's picks</a>,
    practical resources, and fresh inspiration in one useful email. No algorithm, no noise — just the stories worth your time.
  </p>

  <NewsletterCTA />

  <section class="mt-stack-lg" aria-labelledby="rss-option-heading">
    <h2 id="rss-option-heading" class="font-headline-md font-bold text-primary text-lg mb-2">
      Prefer to follow every update?
    </h2>
    <p class="text-on-surface-variant text-sm leading-relaxed mb-4">
      Subscribe through RSS to get new Web Design Feed stories directly in your preferred feed reader.
    </p>
    <a
      href="/feeds"
      class="inline-flex items-center gap-2 border border-outline text-primary font-label-md text-label-md px-5 py-2.5 rounded-lg hover:bg-surface-variant transition-colors font-semibold"
    >
      <Icon name="rss_feed" size={18} />
      Explore RSS feeds
    </a>
  </section>
</BaseLayout>
