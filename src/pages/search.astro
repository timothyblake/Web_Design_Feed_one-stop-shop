---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import PageHeading from '../components/ui/PageHeading.astro';
import StoryCard from '../components/ui/StoryCard.astro';
import ViewToggle from '../components/ui/ViewToggle.astro';
import { categoryLabel } from '../consts';

const stories = (await getCollection('stories')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
---

<BaseLayout title="Search" description="Search Web Design Feed stories." noindex>
  <Breadcrumb items={[{ label: 'Search', href: '/search' }]} />

  <PageHeading>
    Search stories
    <ViewToggle slot="actions" />
  </PageHeading>

  <form id="story-search-form" action="/search" method="get" role="search" class="mb-6">
    <label for="story-search-query" class="sr-only">Search stories</label>
    <div class="flex gap-2">
      <input
        id="story-search-query"
        type="search"
        name="q"
        placeholder="Search titles, topics, sources, or categories…"
        autocomplete="off"
        class="min-w-0 flex-1 rounded-xl border border-[#dee2e6] bg-surface px-4 py-2.5 text-primary placeholder:text-on-surface-variant focus:outline-none focus-visible:ring-1 focus-visible:ring-secondary"
      />
      <button
        type="submit"
        class="rounded-xl bg-secondary px-5 py-2.5 font-semibold text-on-secondary transition-opacity hover:opacity-90"
      >
        Search
      </button>
    </div>
  </form>

  <p id="search-status" class="mb-4 text-sm text-on-surface-variant" aria-live="polite">
    Enter a word or phrase to search all posts.
  </p>

  <ol
    id="search-results"
    data-story-list
    class="is-grid-view flex flex-col gap-stack-md list-none p-0 m-0"
  >
    {stories.map((story) => {
      const { title, description, source, category, tags } = story.data;
      const searchText = [
        title,
        description,
        source,
        category,
        categoryLabel(category),
        ...tags,
      ].join(' ').toLocaleLowerCase();

      return (
        <li data-search-item data-search-text={searchText} hidden>
          <StoryCard story={story} />
        </li>
      );
    })}
  </ol>

  <p id="search-empty" class="hidden py-stack-lg text-center text-on-surface-variant">
    No posts match that search. Try a different title, topic, source, category, or tag.
  </p>
</BaseLayout>

<style>
  :global([data-search-item][hidden]) {
    display: none !important;
  }
</style>

<script>
  function normalize(value: string) {
    return value.trim().toLocaleLowerCase();
  }

  function initStorySearch() {
    const form = document.getElementById('story-search-form') as HTMLFormElement | null;
    const input = document.getElementById('story-search-query') as HTMLInputElement | null;
    const status = document.getElementById('search-status');
    const empty = document.getElementById('search-empty');
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-search-item]'));
    if (!form || !input || !status || !empty) return;

    const filterStories = (rawQuery: string) => {
      const query = normalize(rawQuery);
      const terms = query.split(/\s+/).filter(Boolean);
      let matchCount = 0;

      items.forEach((item) => {
        const searchText = item.dataset.searchText ?? '';
        const matches = terms.length > 0 && terms.every((term) => searchText.includes(term));
        item.hidden = !matches;
        if (matches) matchCount += 1;
      });

      if (!query) {
        status.textContent = 'Enter a word or phrase to search all posts.';
        empty.classList.add('hidden');
        return;
      }

      status.textContent = `${matchCount} ${matchCount === 1 ? 'post' : 'posts'} found for “${rawQuery.trim()}”.`;
      empty.classList.toggle('hidden', matchCount !== 0);
    };

    const query = new URLSearchParams(window.location.search).get('q') ?? '';
    input.value = query;
    filterStories(query);

    if (form.dataset.searchInit) return;
    form.dataset.searchInit = 'true';

    input.addEventListener('input', () => filterStories(input.value));
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const value = input.value.trim();
      const url = new URL(window.location.href);
      if (value) url.searchParams.set('q', value);
      else url.searchParams.delete('q');
      window.history.pushState({}, '', url);
      filterStories(value);
    });
  }

  initStorySearch();
  document.addEventListener('astro:page-load', initStorySearch);
</script>
