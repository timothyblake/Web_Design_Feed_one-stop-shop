---
import type { GetStaticPaths, Page } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/ui/StoryCard.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import SeoBlurb from '../../components/ui/SeoBlurb.astro';
import PageHeading from '../../components/ui/PageHeading.astro';
import ViewToggle from '../../components/ui/ViewToggle.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const stories = (await getCollection('stories', ({ data }) => data.featured)).sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
  );
  return paginate(stories, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<CollectionEntry<'stories'>> };

const title = page.currentPage === 1
  ? "Editor's Choice: Standout Design & Development Stories"
  : `Editor's Choice — Page ${page.currentPage}`;
---

<BaseLayout
  title={title}
  description="Discover standout UI, UX, web design, and development stories selected by the Web Design Feed editor for their insight, originality, and practical value."
>
  <Breadcrumb items={[{ label: 'Featured', href: '/featured' }]} />

  <PageHeading>
    {page.currentPage === 1 ? "Editor's Choice: Standout Design & Development Stories" : `Editor's Choice — Page ${page.currentPage}`}
    <ViewToggle slot="actions" />
  </PageHeading>
  <p class="text-on-surface-variant mb-stack-md text-sm leading-relaxed">
    A hand-picked collection of useful, original, and thought-provoking stories for people who design,
    build, and shape the web.
  </p>

  <ol data-story-list class="is-grid-view flex flex-col gap-stack-md list-none p-0 m-0">
    {page.data.map((story, i) => (
      <li>
        <StoryCard story={story} priority={page.currentPage === 1 && i < 3} />
      </li>
    ))}
  </ol>

  {page.data.length === 0 && (
    <p class="text-on-surface-variant py-stack-lg text-center">No Editor's Choice stories are available yet.</p>
  )}

  {page.lastPage > 1 && (
    <nav aria-label="Pagination" class="mt-8 flex items-center justify-center gap-3 shadow-[inset_0_1px_0_rgba(0,0,0,0.15),0_-1px_0_rgba(255,255,255,0.8)] pt-8">
      {page.url.prev ? (
        <a
          href={page.url.prev}
          class="border border-outline text-primary font-label-md text-label-md px-5 py-2.5 rounded-lg hover:bg-surface-variant transition-all font-semibold"
        >
          Previous
        </a>
      ) : (
        <span aria-hidden="true" class="px-5 py-2.5 opacity-0">Previous</span>
      )}

      <span class="text-on-surface-variant text-sm">
        Page {page.currentPage} of {page.lastPage}
      </span>

      {page.url.next ? (
        <a
          href={page.url.next}
          class="bg-secondary text-on-secondary font-label-md text-label-md px-6 py-2.5 rounded-lg hover:opacity-90 transition-all shadow-sm font-semibold"
        >
          Next
        </a>
      ) : (
        <span aria-hidden="true" class="px-6 py-2.5 opacity-0">Next</span>
      )}
    </nav>
  )}

  {page.currentPage === 1 && (
    <SeoBlurb title="About Editor's Choice on Web Design Feed">
      <p>
        Editor's Choice brings together standout stories from UI and UX design, front-end and web
        development, creative resources, and the business of building for the web.
      </p>
      <p>
        Each selection is chosen for its practical insight, original thinking, or usefulness to people who
        design and build for the web.
      </p>
      <p>
        Browse the latest selections here or get the highlights delivered in the
        <a href="/newsletter" class="underline hover:text-primary">monthly update</a>. Every story links
        directly to the original author and source.
      </p>
    </SeoBlurb>
  )}
</BaseLayout>
